---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerrainArt from '../../components/TerrainArt.astro';
import { getUi, url } from '../../i18n/utils';
import { locales, type Locale } from '../../i18n/locales';
import { officialTrips } from '../../data/trips';
import { SAFETY_CONTACT_EMAIL } from '../../data/config';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const sortedTrips = [...officialTrips].sort((a, b) => a.date.localeCompare(b.date));
const dateFormatter = new Intl.DateTimeFormat(locale === 'ar' ? 'ar' : locale, { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout locale={locale} title={t.trips.title} description={t.trips.intro}>
  <section class="relative overflow-hidden">
    <TerrainArt gradient="from-emerald-950 via-canopy-700 to-lime-500" class="inset-0 h-full w-full" position="absolute">
      <div class="absolute inset-0 bg-black/45"></div>
    </TerrainArt>
    <div class="relative z-10 mx-auto max-w-3xl px-5 py-24 text-white">
      <h1 class="reveal font-display text-4xl font-semibold sm:text-5xl">{t.trips.title}</h1>
      <p class="reveal reveal-delay-1 mt-4 text-lg text-white/85">{t.trips.intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    {sortedTrips.length === 0 ? (
      /* An empty list used to be a dead end: a dashed box saying nothing is
         scheduled, with nowhere to go from it. Someone arriving here wants to
         do something, so give them the three things that are actually useful
         when there is no trip to join. */
      <div class="reveal rounded-2xl border border-black/10 bg-white p-8 sm:p-10">
        <h2 class="font-display text-2xl font-semibold text-ink-950">{t.trips.emptyTitle}</h2>
        <p class="mt-3 max-w-prose leading-relaxed text-ink-900/70">{t.trips.emptyBody}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={`mailto:${SAFETY_CONTACT_EMAIL}?subject=${encodeURIComponent(t.trips.registerInterest)}`}
            class="inline-flex items-center rounded-full bg-canopy-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-canopy-900"
          >
            {t.trips.registerInterest}
          </a>
          <a
            href={url(`/${locale}/#regions`)}
            class="inline-flex items-center rounded-full border border-black/10 px-5 py-2.5 text-sm font-semibold text-ink-900 transition hover:border-canopy-700/40"
          >
            {t.trips.browseAreas}
          </a>
          <a
            href={url(`/${locale}/safety/`)}
            class="inline-flex items-center rounded-full border border-black/10 px-5 py-2.5 text-sm font-semibold text-ink-900 transition hover:border-canopy-700/40"
          >
            {t.trips.readSafety}
          </a>
        </div>
      </div>
    ) : (
      <ul class="space-y-6">
        {sortedTrips.map((trip) => (
          <li class="reveal rounded-2xl border border-black/10 bg-white p-7">
            <p class="text-sm font-semibold uppercase tracking-wide text-canopy-700">
              {dateFormatter.format(new Date(trip.date))}
            </p>
            <h2 class="mt-1.5 font-display text-xl font-semibold text-ink-950">{trip.title[locale]}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-900/75">{trip.description[locale]}</p>
            <p class="mt-3 text-xs text-ink-900/60">{t.trips.organisedBy} {trip.organiser[locale]}</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href={trip.contactUrl}
                class="inline-flex items-center gap-2 rounded-full bg-canopy-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-canopy-900"
              >
                {t.trips.register}
              </a>
              <a
                href={url(`/${locale}/${trip.country}/${trip.areaSlug}/`)}
                class="inline-flex items-center gap-2 rounded-full border border-black/10 px-5 py-2 text-sm font-semibold text-ink-900 transition hover:border-canopy-700/40"
              >
                {t.trips.permitContext}
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  {/* The publishing standard, stated whether or not anything is listed. It is
      what this site requires before it will put a trip in front of anyone, and
      it is the same test the safety page asks a reader to apply themselves. */}
  <section class="border-t border-ink-950/10 bg-white/60 py-16">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="reveal font-display text-2xl font-semibold text-ink-950 sm:text-3xl">{t.trips.standardTitle}</h2>
      <ol class="mt-8 space-y-6">
        {[t.trips.standard1, t.trips.standard2, t.trips.standard3, t.trips.standard4].map((line, i) => (
          <li class="reveal flex gap-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-canopy-100 font-display text-sm font-semibold text-canopy-900">
              {i + 1}
            </span>
            <p class="leading-relaxed text-ink-900/80">{line}</p>
          </li>
        ))}
      </ol>
      <p class="reveal mt-8 text-sm leading-relaxed text-ink-900/55">{t.trips.standardNote}</p>
    </div>
  </section>
</BaseLayout>
