---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TerrainArt from '../../../components/TerrainArt.astro';
import PermitBox from '../../../components/PermitBox.astro';
import SeasonBox from '../../../components/SeasonBox.astro';
import { getUi, url } from '../../../i18n/utils';
import { locales, type Locale } from '../../../i18n/locales';
import { singaporeAreas } from '../../../data/singapore';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    singaporeAreas.map((area) => ({ params: { locale, slug: area.slug }, props: { locale, area } }))
  );
}

interface Props {
  locale: Locale;
  area: (typeof singaporeAreas)[number];
}

const { locale, area } = Astro.props;
const t = getUi(locale);
---

<BaseLayout locale={locale} title={area.name[locale]} description={area.tagline[locale]}>
  <section class="relative flex min-h-[60vh] items-end overflow-hidden">
    <TerrainArt gradient={area.heroGradient} class="inset-0 h-full w-full" position="absolute" label={t.common.photoCredit} animated>
      <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/15 to-black/5"></div>
    </TerrainArt>
    <div class="relative z-10 mx-auto w-full max-w-5xl px-5 pb-14 pt-28 text-white">
      <a href={url(`/${locale}/singapore/`)} class="reveal text-sm font-medium text-white/80 hover:text-white">← {t.common.backTo} {t.nav.singapore}</a>
      <h1 class="reveal reveal-delay-1 mt-4 max-w-2xl font-display text-4xl font-semibold sm:text-5xl">{area.name[locale]}</h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-xl text-lg text-white/85">{area.tagline[locale]}</p>
      <dl class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="text-white/60">{t.common.difficulty}</dt><dd class="font-semibold">{t.common[area.difficulty]}</dd></div>
        <div><dt class="text-white/60">{t.common.duration}</dt><dd class="font-semibold">{area.duration[locale]}</dd></div>
        {area.elevationM && (
          <div><dt class="text-white/60">{t.common.elevation}</dt><dd class="font-semibold">{area.elevationM} m</dd></div>
        )}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-10">
        <div class="reveal">
          <p class="text-lg leading-relaxed text-ink-900/80">{area.overview[locale]}</p>
        </div>

        <div class="reveal">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.highlights}</h2>
          <ul class="mt-4 space-y-2">
            {area.highlights[locale].map((item) => (
              <li class="flex items-start gap-2 text-ink-900/80">
                <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-canopy-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.gettingThere}</h2>
          <p class="mt-3 text-ink-900/80">{area.gettingThere[locale]}</p>
        </div>

        <div class="reveal rounded-2xl border border-red-900/10 bg-red-50 p-6">
          <h2 class="font-display text-xl font-semibold text-red-950">{t.common.safetyTips}</h2>
          <p class="mt-3 text-red-900/80">{area.safety[locale]}</p>
        </div>

        <div class="reveal">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.whatToBring}</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {area.whatToBring[locale].map((item) => (
              <li class="flex items-start gap-2 text-ink-900/80">
                <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sun-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="space-y-6">
        <PermitBox locale={locale} area={area} />
        <SeasonBox locale={locale} area={area} />
        {area.officialLinks.length > 0 && (
          <div class="reveal reveal-delay-2 rounded-2xl border border-black/10 p-6">
            <h2 class="font-display text-base font-semibold text-ink-950">{t.common.officialSource}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {area.officialLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-canopy-700 underline underline-offset-2 hover:text-canopy-900">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
