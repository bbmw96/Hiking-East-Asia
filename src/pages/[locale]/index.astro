---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AscentHero from '../../components/AscentHero.astro';
import AscentChapters from '../../components/AscentChapters.astro';
import type { Chapter } from '../../components/AscentChapters.astro';
import CountryCard from '../../components/CountryCard.astro';
import { getUi, url } from '../../i18n/utils';
import { locales, type Locale } from '../../i18n/locales';
import { getLiveCountries } from '../../data/countries';
import { allAreas } from '../../data/all-areas';
import { getOfficialChannels } from '../../data/channels';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const countries = getLiveCountries();
const [lead, ...rest] = countries;

/* Three beats, climbing. The copy is the site's real argument; the altitude
   band is the frame that carries it. */
const chapters: Chapter[] = [
  {
    label: t.home.ch1,
    altitude: 210,
    title: t.home.introTitle,
    body: t.home.introBody,
    statValue: String(countries.length),
    statLabel: t.home.stat1Label,
    statNote: t.home.stat1Note,
  },
  {
    label: t.home.ch2,
    altitude: 1290,
    title: t.home.whyTitle,
    body: t.home.whyBody,
    statValue: String(getOfficialChannels().length),
    statLabel: t.home.stat2Label,
    statNote: t.home.stat2Note,
  },
  {
    label: t.home.ch3,
    altitude: 2810,
    title: t.home.safetyCtaTitle,
    body: t.home.safetyCtaBody,
    statValue: String(allAreas.length),
    statLabel: t.home.stat3Label,
    statNote: t.home.stat3Note,
    ctaLabel: t.home.safetyCtaButton,
    ctaHref: url(`/${locale}/safety/`),
  },
];
---

<BaseLayout locale={locale} title={t.home.heroTitle} description={t.home.heroSubtitle}>
  <AscentHero
    eyebrow={t.home.heroEyebrow}
    title={t.home.heroTitle}
    subtitle={t.home.heroSubtitle}
    ctaLabel={t.home.heroCta}
    ctaHref={url(`/${locale}/malaysia/`)}
    altitudeLabel={t.home.altitude}
  />

  <AscentChapters chapters={chapters} altitudeLabel={t.home.altitude} />

  {/* One countries section, not two. The first cell leads; the rest follow at
      a smaller weight, so the grid has a hierarchy instead of twelve equals. */}
  <section id="regions" class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
    <div class="max-w-2xl">
      <h2 class="reveal font-display text-3xl font-semibold text-ink-950 sm:text-4xl">{t.home.regionsTitle}</h2>
      <p class="reveal reveal-delay-1 mt-4 text-lg leading-relaxed text-ink-900/70">{t.home.regionsBody}</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {lead && (
        <div class="sm:col-span-2 lg:row-span-2">
          <CountryCard locale={locale} country={lead} lead />
        </div>
      )}
      {rest.map((country) => (
        <CountryCard locale={locale} country={country} />
      ))}
    </div>
  </section>
</BaseLayout>
