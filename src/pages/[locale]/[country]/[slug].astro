---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaPhoto from '../../../components/AreaPhoto.astro';
import OnThisPage from '../../../components/OnThisPage.astro';
import PermitBox from '../../../components/PermitBox.astro';
import SeasonBox from '../../../components/SeasonBox.astro';
import TrailMap from '../../../components/TrailMap.astro';
import SeasonNow from '../../../components/SeasonNow.astro';
import WeatherNow from '../../../components/WeatherNow.astro';
import { getUi, url } from '../../../i18n/utils';
import { locales, type Locale } from '../../../i18n/locales';
import { allAreas } from '../../../data/all-areas';
import { getCountry } from '../../../data/countries';
import type { Area } from '../../../data/types';

/* One template for every trail area in every country. The pages used to be
   thirteen copies of this file, one per country folder, and they drifted. */
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    allAreas.map((area) => ({ params: { locale, country: area.country, slug: area.slug }, props: { locale, area } }))
  );
}

interface Props {
  locale: Locale;
  area: Area;
}

const { locale, area } = Astro.props;
const t = getUi(locale);
const country = getCountry(area.country)!;

const toc = [
  { id: 'highlights', label: t.common.highlights },
  { id: 'getting-there', label: t.common.gettingThere },
  { id: 'safety', label: t.common.safetyTips },
  { id: 'what-to-bring', label: t.common.whatToBring },
  { id: 'permit', label: t.common.permit },
  { id: 'season', label: t.common.bestMonths },
  { id: 'weather', label: t.weatherNow.title },
  { id: 'map', label: t.map.title },
  ...(area.officialLinks.length > 0 ? [{ id: 'official-source', label: t.common.officialSource }] : []),
];
---

<BaseLayout locale={locale} title={area.name[locale]} description={area.tagline[locale]}>
  {/* No overflow-hidden here: the contents menu opens below the hero edge.
      The background art clips itself. */}
  <section class="relative flex min-h-[60vh] items-end">
    <AreaPhoto
      photoKey={`areas/${area.country}/${area.slug}`}
      alt={area.heroAlt[locale]}
      gradient={area.heroGradient}
      class="inset-0 h-full w-full"
      position="absolute"
      label={t.common.photoCredit}
      animated
      eager
    >
      <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/15 to-black/5"></div>
    </AreaPhoto>
    <div class="relative z-10 mx-auto w-full max-w-5xl px-5 pb-14 pt-28 text-white">
      <a href={url(`/${locale}/${area.country}/`)} class="reveal text-sm font-medium text-white/80 hover:text-white">← {t.common.backTo} {country.name[locale]}</a>
      <h1 class="reveal reveal-delay-1 mt-4 max-w-2xl font-display text-4xl font-semibold sm:text-5xl">{area.name[locale]}</h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-xl text-lg text-white/85">{area.tagline[locale]}</p>
      <dl class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="text-white/60">{t.common.difficulty}</dt><dd class="font-semibold">{t.common[area.difficulty]}</dd></div>
        <div><dt class="text-white/60">{t.common.duration}</dt><dd class="font-semibold">{area.duration[locale]}</dd></div>
        {area.elevationM && (
          <div><dt class="text-white/60">{t.common.elevation}</dt><dd class="font-semibold">{area.elevationM} m</dd></div>
        )}
      </dl>
      <div class="reveal reveal-delay-4 mt-8">
        <OnThisPage locale={locale} items={toc} />
      </div>
    </div>
  </section>

  {/* Before everything else on the page, not folded into the usual safety box
      further down: the closure and legal-risk status of North Korea is not a
      hiking tip, it is the one fact nobody reading this page should miss. */}
  {area.country === 'north-korea' && (
    <section class="mx-auto max-w-5xl px-5 pt-10">
      <div class="reveal rounded-2xl border border-red-900/15 bg-red-50 p-6 sm:p-7">
        <h2 class="font-display text-lg font-semibold text-red-950 sm:text-xl">{t.northKorea.noticeTitle}</h2>
        <p class="mt-3 leading-relaxed text-red-900/85">{t.northKorea.noticeBody}</p>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-5 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-10">
        <div class="reveal">
          <p class="text-lg leading-relaxed text-ink-900/80">{area.overview[locale]}</p>
        </div>

        <div id="highlights" class="reveal scroll-mt-28">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.highlights}</h2>
          <ul class="mt-4 space-y-2">
            {area.highlights[locale].map((item) => (
              <li class="flex items-start gap-2 text-ink-900/80">
                <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-canopy-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div id="getting-there" class="reveal scroll-mt-28">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.gettingThere}</h2>
          <p class="mt-3 text-ink-900/80">{area.gettingThere[locale]}</p>
        </div>

        <div id="safety" class="reveal scroll-mt-28 rounded-2xl border border-red-900/10 bg-red-50 p-6">
          <h2 class="font-display text-xl font-semibold text-red-950">{t.common.safetyTips}</h2>
          <p class="mt-3 text-red-900/80">{area.safety[locale]}</p>
        </div>

        <div id="what-to-bring" class="reveal scroll-mt-28">
          <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.whatToBring}</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {area.whatToBring[locale].map((item) => (
              <li class="flex items-start gap-2 text-ink-900/80">
                <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sun-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="space-y-6">
        <div id="permit" class="scroll-mt-28"><PermitBox locale={locale} area={area} /></div>
        <div id="season" class="scroll-mt-28 space-y-6">
          <SeasonBox locale={locale} area={area} />
          <SeasonNow locale={locale} area={area} />
        </div>
        <div id="weather" class="scroll-mt-28"><WeatherNow locale={locale} area={area} /></div>
        <div id="map" class="reveal reveal-delay-1 scroll-mt-28">
          <h2 class="font-display text-base font-semibold text-ink-950">{t.map.coordinates}</h2>
          <TrailMap
            locale={locale}
            mode="area"
            class="mt-3"
            points={[{ lat: area.coordinates.lat, lng: area.coordinates.lng, label: area.name[locale], detail: area.region }]}
          />
        </div>
        {area.officialLinks.length > 0 && (
          <div id="official-source" class="reveal reveal-delay-2 scroll-mt-28 rounded-2xl border border-black/10 p-6">
            <h2 class="font-display text-base font-semibold text-ink-950">{t.common.officialSource}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {area.officialLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-canopy-700 underline underline-offset-2 hover:text-canopy-900">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
