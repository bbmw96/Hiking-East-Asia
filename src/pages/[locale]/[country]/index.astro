---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaPhoto from '../../../components/AreaPhoto.astro';
import TerrainArt from '../../../components/TerrainArt.astro';
import AreaCard from '../../../components/AreaCard.astro';
import TrailMap from '../../../components/TrailMap.astro';
import RegionIndex from '../../../components/RegionIndex.astro';
import OnThisPage from '../../../components/OnThisPage.astro';
import { getUi, url } from '../../../i18n/utils';
import { locales, type Locale } from '../../../i18n/locales';
import { countries, getLiveCountries } from '../../../data/countries';
import { getAreasByCountry } from '../../../data/all-areas';
import { divisionsForCountry } from '../../../data/hierarchy';
import type { CountryMeta, CountrySlug } from '../../../data/types';

/* One template for every country: the live guide, or a placeholder while a
   country is still marked coming-soon in data/countries.ts. */
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    countries.map((country) => ({ params: { locale, country: country.slug }, props: { locale, country } }))
  );
}

interface Props {
  locale: Locale;
  country: CountryMeta;
}

const { locale, country } = Astro.props;
const t = getUi(locale);
const slug = country.slug as CountrySlug;
const live = country.status === 'live';
const areas = live ? getAreasByCountry(slug) : [];
const hasRegions = live && divisionsForCountry(slug).length > 0;
const liveCountries = getLiveCountries();

const toc = [
  { id: 'map', label: t.map.title },
  { id: 'trails', label: t.common.exploreTrails },
  ...(hasRegions ? [{ id: 'regions', label: t.regions.title }] : []),
];
---

<BaseLayout locale={locale} title={country.name[locale]} description={country.teaser[locale]}>
  {live ? (
    <>
      {/* No overflow-hidden here: the contents menu opens below the hero edge.
          The background art clips itself. */}
      <section class="relative flex min-h-[55vh] items-end">
        <AreaPhoto
          photoKey={`countries/${country.slug}`}
          alt={country.name[locale]}
          gradient={country.heroGradient}
          class="inset-0 h-full w-full"
          position="absolute"
          animated
          eager
        >
          <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-black/5"></div>
        </AreaPhoto>
        <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-14 pt-28 text-white">
          <p class="reveal text-4xl">{country.flagEmoji}</p>
          <h1 class="reveal reveal-delay-1 mt-3 font-display text-4xl font-semibold sm:text-5xl">{country.name[locale]}</h1>
          <p class="reveal reveal-delay-2 mt-4 max-w-xl text-lg text-white/85">{country.teaser[locale]}</p>
          <div class="reveal reveal-delay-3 mt-8">
            <OnThisPage locale={locale} items={toc} />
          </div>
        </div>
      </section>

      {/* The whole country is closed to almost all foreign tourism, and for some
          readers attempting it carries a real legal risk independent of that.
          It sits before anything else on the page rather than inside a safety
          box further down, because this is the one fact nobody should miss. */}
      {country.slug === 'north-korea' && (
        <section class="mx-auto max-w-4xl px-5 pt-10">
          <div class="reveal rounded-2xl border border-red-900/15 bg-red-50 p-6 sm:p-7">
            <h2 class="font-display text-lg font-semibold text-red-950 sm:text-xl">{t.northKorea.noticeTitle}</h2>
            <p class="mt-3 leading-relaxed text-red-900/85">{t.northKorea.noticeBody}</p>
          </div>
        </section>
      )}

      <section id="map" class="mx-auto max-w-6xl scroll-mt-28 px-5 pt-14">
        <TrailMap
          locale={locale}
          mode="region"
          points={areas.map((a) => ({
            lat: a.coordinates.lat,
            lng: a.coordinates.lng,
            label: a.name[locale],
            detail: a.region,
            href: url(`/${locale}/${a.country}/${a.slug}/`),
          }))}
        />
      </section>

      <section id="trails" class="mx-auto max-w-6xl scroll-mt-28 px-5 py-16">
        <h2 class="reveal font-display text-2xl font-semibold text-ink-950">{t.common.exploreTrails}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {areas.map((area) => (
            <AreaCard locale={locale} area={area} />
          ))}
        </div>
      </section>

      <div id="regions" class="scroll-mt-28">
        <RegionIndex locale={locale} country={slug} />
      </div>
    </>
  ) : (
    <section class="relative flex min-h-[70vh] items-center overflow-hidden">
      <TerrainArt gradient={country.heroGradient} class="inset-0 h-full w-full" position="absolute" animated>
        <div class="absolute inset-0 bg-black/45"></div>
      </TerrainArt>
      <div class="relative z-10 mx-auto w-full max-w-3xl px-5 py-24 text-center text-white">
        <p class="reveal text-5xl">{country.flagEmoji}</p>
        <h1 class="reveal reveal-delay-1 mt-4 font-display text-4xl font-semibold sm:text-5xl">{country.name[locale]}</h1>
        <p class="reveal reveal-delay-2 mt-4 text-lg text-white/85">{country.teaser[locale]}</p>
        <span class="reveal reveal-delay-3 mt-8 inline-flex items-center gap-2 rounded-full bg-white/95 px-5 py-2.5 text-sm font-semibold text-ink-950">
          {t.common.comingSoon}
        </span>
        <p class="reveal reveal-delay-4 mt-10 flex flex-wrap justify-center gap-x-3 gap-y-1 text-sm text-white/70">
          {liveCountries.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a href={url(`/${locale}/${c.slug}/`)} class="underline underline-offset-2 hover:text-white">{c.name[locale]}</a>
            </>
          ))}
        </p>
      </div>
    </section>
  )}
</BaseLayout>
