---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerrainArt from '../../components/TerrainArt.astro';
import VerifyChecklist from '../../components/VerifyChecklist.astro';
import OfficialChannelsList from '../../components/OfficialChannelsList.astro';
import CountrySafetyPanel from '../../components/CountrySafetyPanel.astro';
import { getUi } from '../../i18n/utils';
import { locales, type Locale } from '../../i18n/locales';
import { SAFETY_CONTACT_EMAIL } from '../../data/config';
import { getLiveCountries } from '../../data/countries';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const countries = getLiveCountries();

const tips = [
  { title: t.safety.tip1Title, body: t.safety.tip1Body },
  { title: t.safety.tip2Title, body: t.safety.tip2Body },
  { title: t.safety.tip3Title, body: t.safety.tip3Body },
  { title: t.safety.tip4Title, body: t.safety.tip4Body },
  { title: t.safety.tip5Title, body: t.safety.tip5Body },
];

/* The pattern is written as stages, not as a story about anyone. Every name,
   group and figure was stripped before it was written down. */
const scamSteps = [
  { title: t.safety.scamStep1Title, body: t.safety.scamStep1Body },
  { title: t.safety.scamStep2Title, body: t.safety.scamStep2Body },
  { title: t.safety.scamStep3Title, body: t.safety.scamStep3Body },
  { title: t.safety.scamStep4Title, body: t.safety.scamStep4Body },
  { title: t.safety.scamStep5Title, body: t.safety.scamStep5Body },
];
---

<BaseLayout locale={locale} title={t.safety.title} description={t.safety.intro}>
  <section class="relative overflow-hidden">
    <TerrainArt gradient="from-slate-900 via-emerald-900 to-emerald-700" class="inset-0 h-full w-full" position="absolute">
      <div class="absolute inset-0 bg-black/50"></div>
    </TerrainArt>
    <div class="relative z-10 mx-auto max-w-3xl px-5 py-24 text-white">
      <h1 class="reveal font-display text-4xl font-semibold sm:text-5xl">{t.safety.title}</h1>
      <p class="reveal reveal-delay-1 mt-4 text-lg text-white/85">{t.safety.intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    <ol class="space-y-10">
      {tips.map((tip, i) => (
        <li class="reveal flex gap-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-canopy-700 text-sm font-semibold text-white">
            {i + 1}
          </span>
          <div>
            <h2 class="font-display text-xl font-semibold text-ink-950">{tip.title}</h2>
            <p class="mt-2 leading-relaxed text-ink-900/75">{tip.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {/* The pattern. Dark band so it reads as the one warning on the page rather
      than as another card in a stack of advice. */}
  <section class="bg-ink-950 py-20 text-white">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="reveal font-display text-3xl font-semibold sm:text-4xl">{t.safety.scamTitle}</h2>
      <p class="reveal reveal-delay-1 mt-4 max-w-2xl leading-relaxed text-white/70">{t.safety.scamIntro}</p>

      <ol class="mt-12 space-y-px">
        {scamSteps.map((step, i) => (
          <li class="reveal grid gap-x-6 gap-y-2 border-t border-white/12 py-6 sm:grid-cols-[3rem_1fr]">
            <span class="font-display text-2xl font-semibold text-sun-500 tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-xl font-semibold">{step.title}</h3>
              <p class="mt-2 max-w-2xl leading-relaxed text-white/70">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="reveal mt-12 rounded-2xl border border-canopy-300/30 bg-canopy-900/60 p-7">
        <h3 class="font-display text-xl font-semibold text-canopy-300">{t.safety.scamBreakTitle}</h3>
        <p class="mt-3 leading-relaxed text-white/85">{t.safety.scamBreakBody}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    <VerifyChecklist locale={locale} />
  </section>

  {/* Per country. Twelve legal positions, not one, because they genuinely differ. */}
  <section id="by-country" class="border-t border-ink-950/10 bg-white/60 py-20">
    <div class="mx-auto max-w-5xl px-5">
      <div class="max-w-2xl">
        <h2 class="reveal font-display text-3xl font-semibold text-ink-950 sm:text-4xl">
          {t.safety.countriesTitle}
        </h2>
        <p class="reveal reveal-delay-1 mt-4 leading-relaxed text-ink-900/70">{t.safety.countriesIntro}</p>
      </div>

      <nav class="reveal mt-8" aria-label={t.safety.jumpTo}>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-900/55">{t.safety.jumpTo}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {countries.map((c) => (
            <li>
              <a
                href={`#safety-${c.slug}`}
                class="inline-flex items-center gap-2 rounded-full border border-ink-950/10 bg-white px-3.5 py-1.5 text-sm text-ink-900 transition hover:border-canopy-700 hover:text-canopy-700"
              >
                <span aria-hidden="true">{c.flagEmoji}</span>
                {c.name[locale]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-6">
        {countries.map((c) => (
          <CountrySafetyPanel locale={locale} country={c} />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    <OfficialChannelsList locale={locale} />

    <div class="reveal mt-14 rounded-2xl border border-red-900/15 bg-red-50 p-7">
      <h2 class="font-display text-xl font-semibold text-red-950">{t.safety.reportTitle}</h2>
      <p class="mt-3 leading-relaxed text-red-900/85">{t.safety.reportBody}</p>
      <a
        href={`mailto:${SAFETY_CONTACT_EMAIL}`}
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-red-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-950"
      >
        {t.safety.reportButton}
      </a>
    </div>
  </section>

  <script>
    /* A jump link must open the country it points at. Without this the anchor
       scrolls to a closed summary and the answer stays hidden. Runs on load for
       a deep link and on every in-page hash change. */
    const openTarget = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      if (el instanceof HTMLDetailsElement) {
        el.open = true;
        el.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
      }
    };
    addEventListener('hashchange', openTarget);
    openTarget();
  </script>
</BaseLayout>
