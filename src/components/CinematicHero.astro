---
import TerrainArt from './TerrainArt.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, title, subtitle, ctaLabel, ctaHref } = Astro.props;

// Words are already in the DOM and already laid out; the split-line mask
// only moves them into place, so the headline still reads with JS disabled
// or with reduced motion. Scripts without spaces (Chinese) simply fall back
// to a single reveal unit for the whole line.
const words = title.split(' ').filter(Boolean);
---

<section class="relative flex min-h-[100svh] items-end overflow-hidden" data-parallax-hero>
  <TerrainArt gradient="from-emerald-950 via-emerald-800 to-lime-500" class="inset-0 h-full w-full" position="absolute" animated icon={false} />

  <div class="hero-layers" aria-hidden="true">
    <svg class="hero-layer" style="--depth-x: 8; --depth-y: 0.04;" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path
        d="M0 420 L120 360 L260 400 L400 320 L560 380 L720 300 L880 370 L1040 310 L1200 380 L1360 340 L1440 400 L1440 600 L0 600 Z"
        fill="rgb(11 20 16 / 0.28)"
      />
    </svg>
    <svg class="hero-layer" style="--depth-x: 14; --depth-y: 0.08;" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path
        d="M0 480 L160 380 L320 440 L480 340 L640 430 L800 350 L960 440 L1120 370 L1280 450 L1440 400 L1440 600 L0 600 Z"
        fill="rgb(11 20 16 / 0.48)"
      />
    </svg>
    <svg class="hero-layer" style="--depth-x: 22; --depth-y: 0.14;" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path
        d="M0 560 L200 440 L380 520 L560 420 L760 510 L960 430 L1160 520 L1360 460 L1440 500 L1440 600 L0 600 Z"
        fill="rgb(11 20 16 / 0.78)"
      />
    </svg>
  </div>

  <div class="absolute inset-0 z-[2] bg-linear-to-t from-black/75 via-black/25 to-black/10" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-16 pt-32 text-white">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-canopy-300">{eyebrow}</p>
    <h1 class="split-reveal mt-4 max-w-3xl text-balance font-display text-4xl font-semibold leading-[1.08] sm:text-6xl">
      {words.map((word, i) => (
        <span class="split-line">
          <span style={`--i: ${i}`}>{word}</span>
        </span>
      ))}
    </h1>
    <p class="reveal reveal-delay-2 mt-5 max-w-xl text-balance text-lg text-white/85">{subtitle}</p>
    <a
      href={ctaHref}
      data-magnetic
      class="reveal reveal-delay-3 mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-canopy-100"
    >
      {ctaLabel}
      <span aria-hidden="true" class="drift-slow">→</span>
    </a>
  </div>

  <div class="absolute inset-x-0 bottom-6 z-10 flex justify-center" aria-hidden="true">
    <span class="drift-slow flex h-9 w-6 items-start justify-center rounded-full border border-white/40 p-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-white/80"></span>
    </span>
  </div>
</section>
