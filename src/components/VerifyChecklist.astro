---
import { getUi } from '../i18n/utils';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const items = [t.verify.item1, t.verify.item2, t.verify.item3, t.verify.item4, t.verify.item5, t.verify.item6];
---

<div class="reveal rounded-2xl border border-canopy-700/20 bg-white p-7" data-verify-checklist>
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="font-display text-xl font-semibold text-ink-950">{t.verify.title}</h2>
    <span class="whitespace-nowrap text-sm font-semibold text-canopy-700" data-verify-progress>0 / {items.length}</span>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-ink-900/70">{t.verify.intro}</p>

  <ul class="mt-5 space-y-3">
    {items.map((item, i) => (
      <li>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-black/5 p-3 transition hover:border-canopy-700/30 has-[:checked]:border-canopy-700/40 has-[:checked]:bg-canopy-100/60">
          <input type="checkbox" data-verify-item={i} class="mt-0.5 h-4 w-4 shrink-0 accent-canopy-700" />
          <span class="text-sm leading-relaxed text-ink-900/85">{item}</span>
        </label>
      </li>
    ))}
  </ul>

  <div class="mt-5 flex items-center justify-between gap-4">
    <p class="hidden text-sm font-medium text-canopy-800" data-verify-done>{t.verify.allDone}</p>
    <button type="button" class="ml-auto rounded-full border border-black/10 px-4 py-1.5 text-xs font-semibold text-ink-900/70 transition hover:border-black/25" data-verify-reset>
      {t.verify.reset}
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'hea-verify-checklist';

  function loadState(total: number): boolean[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.from({ length: total }, (_, i) => Boolean(parsed[i]));
    } catch {
      return Array.from({ length: total }, () => false);
    }
  }

  function saveState(state: boolean[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // localStorage unavailable (private mode, etc.) — checklist still works for this page view
    }
  }

  document.querySelectorAll<HTMLElement>('[data-verify-checklist]').forEach((root) => {
    const checkboxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-verify-item]'));
    const progress = root.querySelector<HTMLElement>('[data-verify-progress]');
    const done = root.querySelector<HTMLElement>('[data-verify-done]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-verify-reset]');

    function render() {
      const state = checkboxes.map((cb) => cb.checked);
      const checkedCount = state.filter(Boolean).length;
      if (progress) progress.textContent = `${checkedCount} / ${checkboxes.length}`;
      if (done) done.classList.toggle('hidden', checkedCount !== checkboxes.length);
      saveState(state);
    }

    const initial = loadState(checkboxes.length);
    checkboxes.forEach((cb, i) => {
      cb.checked = initial[i];
      cb.addEventListener('change', render);
    });
    render();

    resetBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      render();
    });
  });
</script>
