---
import TerrainArt from './TerrainArt.astro';
import credits from '../data/photo-credits.json';
import { url } from '../i18n/utils';

interface Props {
  /** 'areas/<country>/<slug>' or 'countries/<country>' */
  photoKey: string;
  /** Describes the subject for screen readers. Never left empty on content images. */
  alt: string;
  /** Used when no photograph has been added yet. */
  gradient: string;
  class?: string;
  position?: 'relative' | 'absolute';
  eager?: boolean;
  /** Passed to the generated art only; a real photograph shows its credit instead. */
  label?: string;
  animated?: boolean;
  icon?: boolean;
  /** Set when the photo sits inside a link (a card): the credit is printed as
      text, because a link inside a link is invalid and breaks the card apart.
      The linked credit is on the page the card leads to. */
  inLink?: boolean;
}

type Credit = { title: string; author: string; licence: string; sourceUrl: string; ext?: string };

const { photoKey, alt, gradient, class: klass = '', position = 'relative', eager = false, label, animated, icon, inLink = false } = Astro.props;
const table = credits as unknown as Record<string, Credit>;
const credit = photoKey.startsWith('_') ? undefined : table[photoKey];
const src = credit ? url(`/photos/${photoKey}.${credit.ext ?? 'jpg'}`) : null;
---

{src && credit ? (
  <figure class:list={['area-photo', position === 'absolute' && 'is-absolute', klass]}>
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
    {/* Attribution is rendered from the same record that switches the photo on,
        so a photograph can never appear on the site uncredited. */}
    <figcaption class="area-photo-credit">
      {inLink ? <span>{credit.title}</span> : <a href={credit.sourceUrl} target="_blank" rel="noopener noreferrer">{credit.title}</a>}
      <span> · {credit.author} · {credit.licence}</span>
    </figcaption>
    <slot />
  </figure>
) : (
  <TerrainArt gradient={gradient} class={klass} position={position} label={label} animated={animated} icon={icon}>
    <slot />
  </TerrainArt>
)}
