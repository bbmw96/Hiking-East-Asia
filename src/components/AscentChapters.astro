---
export interface Chapter {
  label: string;
  altitude: number;
  title: string;
  body: string;
  statValue: string;
  statLabel: string;
  statNote: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  chapters: Chapter[];
  altitudeLabel: string;
}

const { chapters, altitudeLabel } = Astro.props;

/* The rail is the same scale in every chapter, so the lit tick moving down the
   stack is what tells you how far up you have climbed. */
const PEAK = 4095;
const ticks = chapters.map((c) => c.altitude);
---

<div class="chapters">
  {chapters.map((c, i) => (
    <Fragment>
    <section class="chapter" style={`--i: ${i}; --tint: ${i / Math.max(chapters.length - 1, 1)}`}>
      <div class="chapter-sky" aria-hidden="true"></div>
      <div class="chapter-ridge" aria-hidden="true">
        <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice">
          <path
            d="M0 210 L180 150 L360 200 L540 130 L720 194 L900 128 L1080 196 L1260 146 L1440 200 L1440 300 L0 300 Z"
            fill="currentColor"
          />
        </svg>
      </div>

      {/* Altitude rail: full viewport height, so the frame is never an empty
          band of colour, and the ticks give the ascent a fixed scale. */}
      <div class="chapter-rail" aria-hidden="true">
        {ticks.map((t, ti) => (
          <span class="rail-tick" class:list={[ti === i && 'is-active']} style={`--at: ${(1 - t / PEAK) * 100}%`}>
            <i></i>
            <b>{t.toLocaleString('en-GB')}</b>
          </span>
        ))}
      </div>

      <div class="chapter-inner">
        <div class="chapter-lede">
          <p class="chapter-meta">
            <span class="chapter-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="chapter-label">{c.label}</span>
            <span class="chapter-alt">
              <span class="sr-only">{altitudeLabel}&nbsp;</span>{c.altitude.toLocaleString('en-GB')}&nbsp;m
            </span>
          </p>
          <h2 class="chapter-title">{c.title}</h2>
          <p class="chapter-body">{c.body}</p>
          {c.ctaLabel && c.ctaHref && (
            <a href={c.ctaHref} data-magnetic class="chapter-cta">{c.ctaLabel}</a>
          )}
        </div>

        {/* The right half carries a real figure from the site's own data, so the
            column earns its space instead of being decorative fill. */}
        <aside class="chapter-figure">
          <span class="figure-value">{c.statValue}</span>
          <span class="figure-label">{c.statLabel}</span>
          <span class="figure-rule"></span>
          <p class="figure-note">{c.statNote}</p>
        </aside>
      </div>
    </section>
    {i < chapters.length - 1 && <div class="chapter-dwell" aria-hidden="true"></div>}
    </Fragment>
  ))}
</div>

<script>
  /* One rAF-batched pass writes three custom properties per chapter.

     The outgoing chapter is lifted out through the top of the viewport faster
     than the incoming chapter's edge rises, so it is always moving while it
     leaves. That is what removes both faults the first version had: the peel
     can no longer slice a line of body copy (the copy is already above the
     edge), and there is no longer a stretch of scroll where the frame holds
     still on an empty field of colour. */
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('.chapter'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 768px)');

  if (chapters.length && !reduce) {
    const ease = (edge0: number, edge1: number, x: number) => {
      const t = Math.min(Math.max((x - edge0) / (edge1 - edge0), 0), 1);
      return t * t * (3 - 2 * t);
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight || 1;
      for (let i = 0; i < chapters.length; i++) {
        const ch = chapters[i];
        if (!wide.matches) {
          ch.style.removeProperty('--vis');
          ch.style.removeProperty('--shift');
          ch.style.removeProperty('--p');
          continue;
        }
        const r = ch.getBoundingClientRect();
        const entering = ease(0.95, 0.5, r.top / vh);
        /* Coverage is read from the NEXT chapter's leading edge: sticky
           siblings share a parent, so a pinned chapter keeps top:0 and its own
           bottom never moves. */
        const next = chapters[i + 1] ?? null;
        const covered = next
          ? 1 - Math.min(Math.max(next.getBoundingClientRect().top / vh, 0), 1)
          : 0;
        /* Lift at 0.78 of viewport height per unit of coverage: faster than the
           incoming edge, which rises at 1.0, so the gap between them widens. */
        const lift = -0.78 * covered * vh;
        const rise = (1 - entering) * 56;
        const vis = Math.min(entering, 1 - ease(0.62, 0.96, covered));
        ch.style.setProperty('--vis', vis.toFixed(3));
        ch.style.setProperty('--shift', `${(lift + rise).toFixed(1)}px`);
        /* Progress drives the ridge and the rail, so every frame of scroll
           changes something even while the copy is settled and readable. */
        ch.style.setProperty('--p', (covered || 1 - Math.min(Math.max(r.top / vh, 0), 1)).toFixed(3));
      }
    };

    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
    wide.addEventListener('change', update);
    update();
  }
</script>
