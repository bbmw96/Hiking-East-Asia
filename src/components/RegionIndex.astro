---
import { getUi, url } from '../i18n/utils.ts';
import type { Locale } from '../i18n/locales.ts';
import type { CountrySlug } from '../data/types.ts';
import { divisionsForCountry } from '../data/hierarchy.ts';

interface Props {
  locale: Locale;
  country: CountrySlug;
}

const { locale, country } = Astro.props;
const t = getUi(locale);
const groups = divisionsForCountry(country);
---

{groups.length > 0 && (
  <section class="mx-auto max-w-6xl px-5 pb-16">
    <h2 class="reveal font-display text-2xl font-semibold text-ink-950 sm:text-3xl">{t.regions.title}</h2>
    <p class="reveal reveal-delay-1 mt-3 max-w-2xl leading-relaxed text-ink-900/70">{t.regions.intro}</p>

    <div class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <div class="reveal">
          <h3 class="flex flex-wrap items-baseline gap-x-2 border-b border-ink-950/10 pb-2 font-display text-base font-semibold text-ink-950">
            {g.division}
            <span class="text-xs font-normal text-ink-900/50">
              {(g.areas.length === 1 ? t.regions.areaCount : t.regions.areaCountPlural).replace('{n}', String(g.areas.length))}
            </span>
          </h3>
          <ul class="mt-3 space-y-1.5">
            {g.areas.map((a) => (
              <li>
                <a
                  href={url(`/${locale}/${a.country}/${a.slug}/`)}
                  class="text-sm text-canopy-700 underline-offset-4 hover:underline"
                >
                  {a.name[locale]}
                </a>
                {a.locality && <span class="ms-1.5 text-xs text-ink-900/45">{a.locality}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
