---
import TerrainArt from './TerrainArt.astro';
import { getUi } from '../i18n/utils';
import type { Area } from '../data/types';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  area: Area;
}

const { locale, area } = Astro.props;
const t = getUi(locale);
const difficultyLabel = t.common[area.difficulty];
---

<a href={`/${locale}/${area.country}/${area.slug}/`} class="reveal group block overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
  <TerrainArt gradient={area.heroGradient} class="h-44 w-full" label={t.common.photoCredit} />
  <div class="p-5">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-canopy-700">
      <span>{area.region}</span>
      <span aria-hidden="true">·</span>
      <span>{difficultyLabel}</span>
    </div>
    <h3 class="mt-1.5 font-display text-xl font-semibold text-ink-950">{area.name[locale]}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-900/70">{area.tagline[locale]}</p>
    <div class="mt-3 flex items-center gap-2 text-xs text-ink-900/60">
      <span>{area.permit.required ? t.common.permitRequired : t.common.noPermitNeeded}</span>
      <span aria-hidden="true">·</span>
      <span>{area.duration[locale]}</span>
    </div>
  </div>
</a>
