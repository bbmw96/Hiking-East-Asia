---
import { getUi } from '../i18n/utils';
import type { Locale } from '../i18n/locales';

interface Item {
  id: string;
  label: string;
}

interface Props {
  locale: Locale;
  items: Item[];
  /** Open the panel upwards, for a menu near the bottom of a clipped hero. */
  up?: boolean;
  /** Fade in on scroll. Off where the menu sits in the bottom band of the
      first screen, which the scroll reveal never reaches without a scroll. */
  reveal?: boolean;
}

const { locale, items, up = false, reveal = true } = Astro.props;
const t = getUi(locale);
---

<details class:list={['page-toc', reveal && 'reveal', up && 'opens-up']}>
  <summary class="page-toc-summary">
    <span>{t.common.onThisPage}</span>
    <svg aria-hidden="true" width="11" height="7" viewBox="0 0 10 6" class="page-toc-chevron">
      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul class="page-toc-list">
    {items.map((item) => (
      <li><a href={`#${item.id}`}>{item.label}</a></li>
    ))}
  </ul>
</details>

<script>
  // Native <details> has no "close on outside click / link click" behaviour;
  // add it so the panel does not stay pinned open after the visitor has
  // already jumped to a section.
  document.querySelectorAll<HTMLDetailsElement>('.page-toc').forEach((el) => {
    el.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        requestAnimationFrame(() => { el.open = false; });
      }
    });
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
  });
</script>

