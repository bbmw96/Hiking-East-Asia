---
import { getUi } from '../i18n/utils';
import { getOfficialChannels, channelLabel } from '../data/channels';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
const channels = getOfficialChannels();
---

<div class="reveal reveal-delay-1 rounded-2xl border border-black/10 bg-white p-7">
  <h2 class="font-display text-xl font-semibold text-ink-950">{t.channels.title}</h2>
  <p class="mt-2 text-sm leading-relaxed text-ink-900/70">{t.channels.intro}</p>
  <ul class="mt-5 grid gap-2 sm:grid-cols-2">
    {channels.map((channel) => (
      <li>
        <a
          href={channel.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between gap-2 rounded-xl border border-black/5 px-4 py-3 text-sm text-ink-900 transition hover:border-canopy-700/40 hover:bg-canopy-100/50"
        >
          <span>{channelLabel(channel, locale)}</span>
          <span aria-hidden="true" class="text-canopy-700">↗</span>
        </a>
      </li>
    ))}
  </ul>
</div>
