---
import { getUi } from '../i18n/utils';
import type { Area } from '../data/types';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  area: Area;
}

const { locale, area } = Astro.props;
const t = getUi(locale);
const { season } = area;
---

<div class="reveal reveal-delay-1 rounded-2xl border border-sun-500/25 bg-sun-500/10 p-6">
  <h2 class="font-display text-xl font-semibold text-ink-950">{t.common.bestMonths}</h2>
  <p class="mt-2 text-sm font-medium text-ink-950">{season.bestMonths[locale]}</p>
  {season.avoidMonths && (
    <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-ink-900/60">{t.common.avoidMonths}</p>
  )}
  {season.avoidMonths && <p class="mt-1 text-sm text-ink-900/80">{season.avoidMonths[locale]}</p>}
  <p class="mt-4 text-sm leading-relaxed text-ink-900/70">{season.notes[locale]}</p>
</div>
