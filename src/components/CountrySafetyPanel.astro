---
import { getUi, url } from '../i18n/utils';
import type { Locale } from '../i18n/locales';
import type { CountryMeta } from '../data/types';
import { getAreasByCountry } from '../data/all-areas';
import { getCountrySafety } from '../data/safety-countries';

interface Props {
  locale: Locale;
  country: CountryMeta;
}

const { locale, country } = Astro.props;
const t = getUi(locale);
const slug = country.slug as Parameters<typeof getCountrySafety>[0];
const safety = getCountrySafety(slug);
const areas = getAreasByCountry(slug);

/* Everything below the emergency numbers is derived from the same area records
   the trail pages render, so the law stated here cannot drift away from the
   permit box on the page it describes. */
const permitAreas = areas.filter((a) => a.permit.required);
const total = areas.length;
const needed = permitAreas.length;

const summaryTemplate =
  needed === 0 ? t.safety.permitsNone : needed === total ? t.safety.permitsAll : t.safety.permitsSome;
const permitSummary = summaryTemplate
  .replace('{n}', String(needed))
  .replace('{total}', String(total));

const seenAuthority = new Set<string>();
const authorities: { name: string; url: string }[] = [];
for (const area of permitAreas) {
  const key = `${area.permit.authorityName}|${area.permit.url}`;
  if (seenAuthority.has(key)) continue;
  seenAuthority.add(key);
  authorities.push({ name: area.permit.authorityName, url: area.permit.url });
}

const EMERGENCY_LABEL = {
  all: t.safety.emergencyAll,
  police: t.safety.emergencyPolice,
  fire: t.safety.emergencyFire,
  ambulance: t.safety.emergencyAmbulance,
} as const;
---

<section id={`safety-${country.slug}`} class="scroll-mt-24 border-t border-ink-950/10 py-14 first:border-t-0">
  <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h3 class="reveal flex items-baseline gap-3 font-display text-2xl font-semibold text-ink-950 sm:text-3xl">
      <span aria-hidden="true" class="text-3xl">{country.flagEmoji}</span>
      {country.name[locale]}
    </h3>
    <a
      href={url(`/${locale}/${country.slug}/`)}
      class="text-sm font-semibold text-canopy-700 underline-offset-4 hover:underline"
    >
      {t.safety.viewCountry.replace('{country}', country.name[locale])}
    </a>
  </header>

  {safety && (
    <div class="reveal mt-6 rounded-2xl bg-canopy-900 p-5 text-white sm:p-6">
      <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-canopy-300">
        {t.safety.emergencyHeading}
      </h4>
      <ul class="mt-4 flex flex-wrap gap-x-10 gap-y-4">
        {safety.emergency.map((line) => (
          <li>
            <span class="block text-xs text-white/70">{EMERGENCY_LABEL[line.kind]}</span>
            <a
              href={`tel:${line.number}`}
              class="ltr-only mt-0.5 block font-display text-3xl font-semibold tabular-nums text-white underline-offset-4 hover:underline sm:text-4xl"
            >
              {line.number}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <div class="reveal">
      <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-900/55">
        {t.safety.permitsHeading}
      </h4>
      <p class="mt-3 leading-relaxed text-ink-900/80">{permitSummary}</p>
      {authorities.length > 0 && (
        <>
          <p class="mt-5 text-xs font-semibold uppercase tracking-[0.18em] text-ink-900/55">
            {t.safety.issuedBy}
          </p>
          <ul class="mt-2 space-y-1.5">
            {authorities.map((a) => (
              <li>
                <a
                  href={a.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-canopy-700 underline-offset-4 hover:underline"
                >
                  {a.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>

    {safety && (
      <div class="reveal reveal-delay-1">
        <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-900/55">
          {t.safety.guidesHeading}
        </h4>
        <p class="mt-3 leading-relaxed text-ink-900/80">{safety.guides[locale]}</p>
      </div>
    )}
  </div>

  <div class="reveal mt-10">
    <h4 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-900/55">
      {t.safety.seasonHeading}
    </h4>
    <div class="mt-3 overflow-x-auto rounded-2xl border border-ink-950/10 bg-white">
      <table class="w-full min-w-[38rem] border-collapse text-start text-sm">
        <thead>
          <tr class="border-b border-ink-950/10 text-xs uppercase tracking-wide text-ink-900/55">
            <th scope="col" class="px-4 py-3 text-start font-semibold">{t.safety.colArea}</th>
            <th scope="col" class="px-4 py-3 text-start font-semibold">{t.safety.colRegion}</th>
            <th scope="col" class="px-4 py-3 text-start font-semibold">{t.safety.colPermit}</th>
            <th scope="col" class="px-4 py-3 text-start font-semibold">{t.safety.colBest}</th>
            <th scope="col" class="px-4 py-3 text-start font-semibold">{t.safety.colAvoid}</th>
          </tr>
        </thead>
        <tbody>
          {areas.map((area) => (
            <>
              <tr class="border-t border-ink-950/[0.07]">
                <th scope="row" class="px-4 pb-1.5 pt-4 text-start align-top font-semibold text-ink-950">
                  <a
                    href={url(`/${locale}/${country.slug}/${area.slug}/`)}
                    class="underline-offset-4 hover:underline"
                  >
                    {area.name[locale]}
                  </a>
                </th>
                <td class="px-4 pb-1.5 pt-4 align-top text-ink-900/70">{area.region}</td>
                <td class="px-4 pb-1.5 pt-4 align-top">
                  <span
                    class:list={[
                      'inline-block rounded-full px-2.5 py-1 text-xs font-semibold',
                      area.permit.required
                        ? 'bg-sun-500/20 text-ink-950'
                        : 'bg-canopy-100 text-canopy-900',
                    ]}
                  >
                    {area.permit.required ? t.safety.permitYes : t.safety.permitNo}
                  </span>
                </td>
                <td class="px-4 pb-1.5 pt-4 align-top text-ink-900/80">{area.season.bestMonths[locale]}</td>
                <td class="px-4 pb-1.5 pt-4 align-top text-ink-900/80">{area.season.avoidMonths?.[locale]}</td>
              </tr>
              <tr>
                <td colspan="5" class="px-4 pb-4 text-xs leading-relaxed text-ink-900/60">
                  {area.season.notes[locale]}
                </td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
